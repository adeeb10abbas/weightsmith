+    def start_episode(self, episode_index: int) -> None:
+        """Prepare local client state for an explicitly numbered episode.
+
+        The default only clears cached chunks. Seeded clients override this to
+        bind their request schedule to ``episode_index``, which keeps resumed
+        evaluations reproducible when completed episodes are skipped.
+        """
+        self._chunks.clear()
+        self._counters.clear()
