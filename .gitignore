# local configuration (template: .env.example -> copy to wsp.env); never commit real values or backups
wsp.env
wsp.env.*
!wsp.env.example
!wsp.env.template
.env
.env.*
!.env.example

# experiment data (never commit): projects, episodes, activations, candidates, workspaces
projects/
agents/
data/
episodes/
acts/
cands/
heldout/
state/
notes/
frames/
survey/
logs/
*-logs/
checkpoints/
workspace/
workspaces/
*.npz
*.npy
*.mp4
*.hdf5
*.jpg
*.png
*.log
*.out
*.err
*.bak
*.bak-*
# portable edit files (weightsmith edit export): large ones are release assets, see edits/README.md
*.safetensors
!edits/*.safetensors
edits/downloads/
edits/v2mi-f.safetensors
edits/abl-imgl8.safetensors
# Hugging Face Hub folders written by integrations/hub/export_to_hub.py
/hub/

# ...except the curated, published results and figures (the patterns above match at any depth)
!study/results/data/
!study/results/data/*.png
!study/results/*/heldout/
!**/figures/*.png
!**/figures/*.jpg
!site/data/
!site/assets/**

# editor session state
session_id
thread_id
codex-home/
.claude/

