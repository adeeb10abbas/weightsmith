# Korea pod (vast.ai, 4x RTX PRO 4000 Blackwell 24 GB; GPUs 2 and 3 are Track B's). Copied to src/machine.env there.
export GROOT_WS=/workspace/cross/groot
export GROOT_ROBOLAB=/workspace/weightsmith/third_party/RoboLab
export GROOT_SIM_PY=/workspace/weightsmith/envs/robolab-sim-cu128/.venv/bin/python
