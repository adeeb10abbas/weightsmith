@@ -112,6 +112,15 @@ class InferenceClient(ABC):
         """Public convenience wrapper for callers that want the viz image."""
         return self._build_visualization(self._extract_observation(obs, env_id=env_id))
 
+    def needs_replan(self, *, env_id: int = 0) -> bool:
+        """Return whether the next :meth:`infer` call will request a new chunk.
+
+        Evaluation-side instruction controllers use this to record the exact
+        prompt that reaches a policy server, rather than logging transient
+        state-dependent commands while a cached chunk is still executing.
+        """
+        return self._needs_refresh(env_id)
+
     # ------------------------------------------------------------------
     # Required hooks
     # ------------------------------------------------------------------
diff --git a/robolab/eval/episode.py b/robolab/eval/episode.py
index 9bb2f8e..5afa1e9 100644
--- a/robolab/eval/episode.py
+++ b/robolab/eval/episode.py
@@ -58,7 +58,68 @@ from robolab.core.world.world_state import get_world
 from robolab.eval.base_client import InferenceClient
 
 
-def run_episode(env, env_cfg, episode, client: InferenceClient, *, headless=False, save_videos=True, video_mode="all"):
+def _requested_relation(instruction: str) -> str:
+    """Extract the single left/right relation declared by a benchmark prompt."""
+    matches = set(re.findall(r"\b(left|right)\b", instruction.lower()))
+    if len(matches) != 1:
+        raise ValueError(
+            "predicate_oracle requires an instruction with exactly one left/right relation, "
+            f"got {instruction!r}"
+        )
+    return matches.pop()
+
+
+def _predicate_oracle_command(
+    env, requested_relation: str, *, env_id: int = 0
+) -> tuple[str, dict]:
+    """Choose a low-level command from privileged simulator predicates.
+
+    The controller deliberately supplies no action targets. It only chooses
+    among language commands using perfect knowledge of whether the cube is
+    held and whether its centroid is already in the requested 45-degree cone.
+    """
+    from robolab.core.task.conditionals import object_grabbed
+    from robolab.core.task.predicate_logic import left_of, right_of
+
+    world = get_world(env)
+    held = bool(object_grabbed(env, object="rubiks_cube", env_id=env_id))
+    relation_fn = left_of if requested_relation == "left" else right_of
+    at_requested_side = bool(
+        relation_fn(
+            world,
+            "rubiks_cube",
+            "bowl",
+            frame_of_reference="robot",
+            env_id=env_id,
+        )
+    )
+    if not held:
+        phase = "grasp"
+        command = "Reach for and firmly grasp the rubiks cube"
+    elif not at_requested_side:
+        phase = "spatial_move"
+        command = f"Move the rubiks cube to the {requested_relation} of the bowl"
+    else:
+        phase = "release"
+        command = "Open the gripper and release the rubiks cube"
+    return command, {
+        "held": held,
+        "at_requested_side": at_requested_side,
+        "phase": phase,
+    }
+
+
+def run_episode(
+    env,
+    env_cfg,
+    episode,
+    client: InferenceClient,
+    *,
+    headless=False,
+    save_videos=True,
+    video_mode="all",
+    instruction_controller="static",
+):
     """Run a policy-controlled episode across all parallel envs.
 
     The policy client is constructed by the caller (typically a per-policy
@@ -74,6 +135,8 @@ def run_episode(env, env_cfg, episode, client: InferenceClient, *, headless=Fals
         headless: If True, don't display video
         save_videos: If True, save per-env episode videos
         video_mode: Which videos to save: 'all', 'viewport', 'sensor', or 'none'
+        instruction_controller: ``static`` or the state-aware
+            ``predicate_oracle`` language-command selector.
 
     Returns:
         tuple: (env_results, subtask_status, timing)
@@ -88,6 +151,10 @@ def run_episode(env, env_cfg, episode, client: InferenceClient, *, headless=Fals
     max_steps = env.max_episode_length
     video_fps = 1 / (env_cfg.sim.render_interval * env_cfg.sim.dt) # Hz
     instruction = env_cfg.instruction
+    requested_relation = (
+        _requested_relation(instruction) if instruction_controller == "predicate_oracle" else None
+    )
+    command_history = []
     client.start_episode(episode)
     # Pull action dim from the env's action manager (IsaacLab canonical),
     # falling back to the gym action space if the manager isn't available.
@@ -141,8 +208,21 @@ def run_episode(env, env_cfg, episode, client: InferenceClient, *, headless=Fals
             # loop, so other policies behave exactly as before.
             actions = torch.zeros(env.num_envs, action_dim, device=env.device)
             last_viz = None
+            step_instruction = instruction
+            if instruction_controller == "predicate_oracle":
+                step_instruction, oracle_state = _predicate_oracle_command(
+                    env, requested_relation, env_id=0
+                )
+                if client.needs_replan(env_id=0):
+                    command_history.append(
+                        {
+                            "step": step,
+                            "prompt": step_instruction,
+                            **oracle_state,
+                        }
+                    )
             rets = client.infer_batch(
-                obs, instruction, env_ids=list(env.active_env_ids)
+                obs, step_instruction, env_ids=list(env.active_env_ids)
             )
             for env_id in sorted(rets):
                 ret = rets[env_id]
@@ -209,4 +289,8 @@ def run_episode(env, env_cfg, episode, client: InferenceClient, *, headless=Fals
             logger.exception("Failed to reset client after episode")
 
     timing = timer.to_dict(actual_steps)
+    timing["instruction_controller"] = instruction_controller
+    if requested_relation is not None:
+        timing["requested_relation"] = requested_relation
+        timing["command_history"] = command_history
     return env.get_env_results(), subtask_status, timing
