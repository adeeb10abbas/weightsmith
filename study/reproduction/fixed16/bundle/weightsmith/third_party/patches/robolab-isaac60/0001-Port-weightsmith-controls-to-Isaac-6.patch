+
+"""Neutral-start right counterpart for the matched relation pair.
+
+The canonical right-of-bowl benchmark uses a busier scene than the left task.
+That is useful for benchmark diversity but confounds a language-steerability
+comparison. This task and RubiksCubeLeftOfBowlMatchedTask intentionally use the
+same scene, neutral reset event, object set, episode length, and subtask
+structure while changing only the requested spatial predicate and its language.
+"""
+
+from dataclasses import dataclass
+from functools import partial
+
+import isaaclab.envs.mdp as mdp
+from isaaclab.managers import TerminationTermCfg as DoneTerm
+from isaaclab.utils import configclass
+
+from robolab.core.scenes.utils import import_scene
+from robolab.core.task.conditionals import object_dropped, object_grabbed, object_right_of
+from robolab.core.task.subtask import Subtask
+from robolab.core.task.task import Task
+from robolab.tasks.benchmark._rubiks_cube_relation_matched import RubiksCubeRelationMatchedNeutralInit
+
+
+@configclass
+class RubiksCubeRightOfBowlMatchedTermination:
+    time_out = DoneTerm(func=mdp.time_out, time_out=True)
+    success = DoneTerm(
+        func=object_right_of,
+        params={
+            "object": "rubiks_cube",
+            "reference_object": "bowl",
+            "frame_of_reference": "robot",
+            "mirrored": False,
+            "require_gripper_detached": True,
+        },
+    )
+
+
+@dataclass
+class RubiksCubeRightOfBowlMatchedTask(Task):
+    contact_object_list = ["rubiks_cube", "banana", "bowl", "table"]
+    scene = import_scene("rubiks_cube_banana_bowl.usda", contact_object_list)
+    events = RubiksCubeRelationMatchedNeutralInit
+    terminations = RubiksCubeRightOfBowlMatchedTermination
+    instruction = {
+        "default": "Put the Rubik's cube to the right of the bowl.",
+        "vague": "Put the cube right of the bowl.",
+        "specific": "Pick up the Rubik's cube and place it on the table to the right side of the bowl.",
+        "declarative": "The Rubik's cube should end up to the right of the bowl.",
+        "contrastive": "Put the Rubik's cube to the right of the bowl, not to the left of the bowl.",
+    }
+    attributes = ["spatial", "steerability_matched"]
+    episode_length_s: int = 30
+    subtasks = [
+        Subtask(
+            name="rubiks_cube_right_of_bowl",
+            conditions=[
+                partial(object_grabbed, object="rubiks_cube"),
+                partial(
+                    object_right_of,
+                    object="rubiks_cube",
+                    reference_object="bowl",
+                    frame_of_reference="robot",
+                    mirrored=False,
+                ),
+                partial(object_dropped, object="rubiks_cube"),
+            ],
+            logical="all",
+            score=1.0,
+        )
+    ]
