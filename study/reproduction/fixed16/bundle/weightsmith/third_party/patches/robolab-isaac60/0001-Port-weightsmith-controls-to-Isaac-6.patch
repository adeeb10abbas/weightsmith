+    def finalize_active_envs_as_truncated(self) -> None:
+        """Finalize environments still active when the runner horizon ends.
+
+        IsaacLab's configured timeout is normally responsible for this.  The
+        evaluation runner nevertheless owns the declared control-step horizon,
+        so a still-active environment at loop exhaustion is authoritatively a
+        truncation rather than an unknown result.  Finalizing here also ensures
+        buffered recorder data is exported instead of leaving an empty HDF5
+        demo and ``success=None`` in the summary.
+        """
+        active_ids = self.active_env_ids
+        if not active_ids:
+            return
+
+        if self.recorder_manager is not None:
+            failures = torch.zeros(len(active_ids), dtype=torch.bool, device=self.device)
+            self.recorder_manager.set_success_to_episodes(active_ids, failures)
+
+        for eid in active_ids:
+            self._env_results[eid] = False
+            self._env_term_step[eid] = int(self.episode_length_buf[eid].item())
+            self._frozen_envs[eid] = True
+
+        if self.recorder_manager is not None:
+            try:
+                self.recorder_manager.export_episodes(env_ids=active_ids)
+            except Exception:
+                logger.exception(
+                    "Failed to export recording for horizon-truncated env_ids=%s; "
+                    "episode data may be incomplete.",
+                    active_ids,
+                )
+
     def reset_eval_state(self):
         """Reset frozen state for next episode batch."""
         self._frozen_envs[:] = False
