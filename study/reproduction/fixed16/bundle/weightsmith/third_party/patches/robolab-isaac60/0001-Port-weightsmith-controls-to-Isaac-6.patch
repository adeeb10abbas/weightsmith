+        if self._prediction_output_dir is not None:
+            self._record_prediction(request, response, sampling_seed=sampling_seed)
+        self._replan_index += 1
+        return response
+
+    def _record_prediction(
+        self,
+        request: dict,
+        response: dict,
+        *,
+        sampling_seed: int | None,
+    ) -> None:
+        if "video" not in response:
+            raise RuntimeError("Prediction recording requires a Cosmos server launched with --decode-video True")
+
+        episode_dir = self._prediction_output_dir / f"episode_{self._episode_index:03d}"
+        chunk_dir = episode_dir / f"chunk_{self._replan_index:03d}"
+        chunk_dir.mkdir(parents=True, exist_ok=True)
+
+        image = np.asarray(request["observation/image"], dtype=np.uint8)
+        action = np.asarray(response["action"], dtype=np.float32)
+        video = np.asarray(response["video"], dtype=np.uint8)
+        cv2.imwrite(str(chunk_dir / "conditioning.png"), cv2.cvtColor(image, cv2.COLOR_RGB2BGR))
+        np.save(chunk_dir / "action.npy", action)
+        self._save_video(video, chunk_dir / "future.mp4")
+
+        record = {
+            "episode_index": self._episode_index,
+            "replan_index": self._replan_index,
+            "executed_step_start": self._replan_index * self.open_loop_horizon,
+            "open_loop_horizon": self.open_loop_horizon,
+            "prompt": request["prompt"],
+            "requested_sampling_seed": sampling_seed,
+            "server_sampling_seed": response.get("sampling_seed"),
+            "conditioning_sha256": hashlib.sha256(np.ascontiguousarray(image).tobytes()).hexdigest(),
+            "conditioning_shape": list(image.shape),
+            "action_shape": list(action.shape),
+            "future_shape": list(video.shape),
+            "joint_position": np.asarray(request["observation/joint_position"]).tolist(),
+            "gripper_position": np.asarray(request["observation/gripper_position"]).tolist(),
+            "chunk_dir": str(chunk_dir),
+        }
+        (chunk_dir / "metadata.json").write_text(json.dumps(record, indent=2) + "\n")
+        with (self._prediction_output_dir / "manifest.jsonl").open("a") as handle:
+            handle.write(json.dumps(record) + "\n")
+
+    def _save_video(self, video: np.ndarray, path: Path) -> None:
+        if video.ndim != 4 or video.shape[-1] != 3:
+            raise ValueError(f"Expected future video [T,H,W,3], got {video.shape}")
+        height, width = video.shape[1:3]
+        writer = cv2.VideoWriter(
+            str(path),
+            cv2.VideoWriter_fourcc(*"mp4v"),
+            self._prediction_fps,
+            (width, height),
+        )
+        if not writer.isOpened():
+            raise RuntimeError(f"Could not create predicted video at {path}")
+        for frame in video:
+            writer.write(cv2.cvtColor(frame, cv2.COLOR_RGB2BGR))
+        writer.release()
+
+    def start_episode(self, episode_index: int) -> None:
+        super().start_episode(episode_index)
+        self._episode_index = int(episode_index)
+        self._replan_index = 0
+
+    def reset(self, *, env_id: int | None = None) -> None:
+        super().reset(env_id=env_id)
+        if env_id is None:
+            self._replan_index = 0
 
     def _unpack_response(self, response: object) -> np.ndarray:
         """Accept Cosmos reference, vLLM-Omni, and proxy action replies."""
