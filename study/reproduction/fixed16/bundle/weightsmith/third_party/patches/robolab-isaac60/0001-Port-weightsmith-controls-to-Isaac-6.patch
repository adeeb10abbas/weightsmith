@@ -0,0 +1,57 @@
+import numpy as np
+import pytest
+
+from policies.cosmos3.client import Cosmos3Client
+from policies.pi0_family.client import Pi0DroidJointposClient
+from robolab.eval.base_client import InferenceClient
+
+
+class DummyClient(InferenceClient):
+    open_loop_horizon = 2
+
+    def _extract_observation(self, raw_obs, *, env_id=0):
+        return raw_obs
+
+    def _pack_request(self, extracted_obs, instruction):
+        return {}
+
+    def _query_server(self, request):
+        return {}
+
+    def _unpack_response(self, response):
+        return np.zeros((2, 1))
+
+
+@pytest.mark.parametrize("client_cls", [Cosmos3Client, Pi0DroidJointposClient])
+def test_sampling_seed_is_bound_to_episode_and_replan(monkeypatch, client_cls):
+    monkeypatch.setattr(client_cls, "_connect", lambda self: object())
+    client = client_cls(sampling_seed_base=6100)
+    requests = []
+
+    def fake_infer(request):
+        requests.append(request)
+        return {"action": [], "actions": []}
+
+    monkeypatch.setattr(client, "_infer_with_retry", fake_infer)
+
+    client.start_episode(4)
+    client._query_server({"prompt": "left"})
+    client._query_server({"prompt": "left"})
+    assert [request["sampling_seed"] for request in requests] == [6104000, 6104001]
+
+    # A resumed run must use its actual episode number, not the number of
+    # episodes executed since this client process started.
+    client.start_episode(9)
+    client._query_server({"prompt": "left"})
+    assert requests[-1]["sampling_seed"] == 6109000
+
+
+def test_needs_replan_reports_chunk_boundary():
+    client = DummyClient()
+    assert client.needs_replan(env_id=0)
+    client._set_chunk(0, np.zeros((2, 1)))
+    assert not client.needs_replan(env_id=0)
+    client._next_action(0)
+    assert not client.needs_replan(env_id=0)
+    client._next_action(0)
+    assert client.needs_replan(env_id=0)
