# Copy to wsp.env at the repo root on EACH machine (GPU host and editor machine) and edit.
# Every variable can also be set in the environment, which wins over this file.

# ---- editor machine (where drivers/claude.sh or drivers/astra.sh runs) --------------------
WSP_HOST=                     # ssh host of the GPU box; empty = editor runs on the GPU box itself
WSP_REMOTE_REPO=weightsmith       # path of this repo on the GPU host (absolute or relative to remote $HOME)
# WSP_ROOT=/data/wsp/projects/stack-yellow-red-claude   # project root ON THE GPU HOST; usually per run
# WSP_FRAMES_DIR=             # default: <agent dir>/frames
# WSP_REMOTE_PYTHON=python3   # python on the GPU host with numpy (runs owsp.py)

# ---- GPU host -------------------------------------------------------------------------------
OPENPI_DIR=~/openpi                               # OpenPI fork with request-scoped sampling seeds
OPENPI_PYTHON=~/openpi/.venv/bin/python
# OPENPI_DATA_HOME=~/.cache/openpi                # OpenPI download cache (PaliGemma tokenizer)
CHECKPOINT_DIR=~/.cache/openpi/openpi-assets/checkpoints/pi05_droid_jointpos
BASE_WORKSPACE=~/weightsmith-workspace/pi05_droid_jointpos-full   # created by scripts/prepare_workspace.sh (~11 GB)
ROBOLAB_DIR=~/robolab                             # RoboLab checkout (sim cwd; outputs under output/)
SIM_PYTHON=~/robolab/.venv/bin/python             # Isaac Sim / Isaac Lab python with RoboLab installed

# GPUs. Reference box: 2x RTX 3090 24 GB -> evals (policy server + 16-env Isaac) on GPU 1,
# activation captures on GPU 0:  WSP_SERVER_GPU=1 WSP_SIM_GPU=1 WSP_ACTS_GPU=0.
# Single GPU: leave all at 0; the per-GPU locks then serialize evals and captures.
WSP_SERVER_GPU=0
WSP_SIM_GPU=0
WSP_ACTS_GPU=0
# WSP_SERVER_MEM_FRACTION=0.40   # XLA memory fraction of the eval policy server (shares its GPU with Isaac)
# WSP_ACTS_MEM_FRACTION=.9
# WSP_EVAL_EXTRA_GPUS=0       # extra GPUs an eval may borrow when idle; each runs its own server + Isaac lane
#                             # (2 healthy GPUs -> ~2x eval throughput). Lane i listens on WSP_POOL_PORT+i.
# WSP_POOL_PORT=8300             # websocket port of the eval policy server
# WSP_VK_ICD=/usr/share/vulkan/icd.d/nvidia_icd.json

# Shared locations (defaults shown)
# WSP_LOCK_DIR=~/.cache/weightsmith/locks   # GPU flock files, shared by all projects on the host
# WSP_JAX_CACHE=~/.cache/weightsmith/jax
# WSP_LOG_DIR=<repo>/logs
# WSP_SURVEY_DIR=<repo>/survey
